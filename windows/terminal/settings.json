      "command": "find",
      "keys": "ctrl+shift+f"
    },
    {
      "command": "paste",
      "keys": "ctrl+v"
    },
    {
      "command": {
        "action": "copy",
        "singleLine": false
      },
      "keys": "ctrl+c"
    },
    {
      "command": {
        "action": "clearBuffer",
        "clear": "all"
      },
      "keys": "ctrl+shift+l"
    },
    {
      "command": {
        "action": "sendInput",
        "input": "\n"
      },
      "keys": "shift+enter"
    }
  ],
